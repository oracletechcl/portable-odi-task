# Copy to ignored local config. No defaults and no secrets.
VM_PUBLIC_IP=
VM_SSH_USER=
# Absolute path, or a path relative to this config file.
VM_SSH_KEY_PATH=
AIRFLOW_INSTANCE_OCID=
AIRFLOW_HOME=
AIRFLOW_DAGS_FOLDER=
AIRFLOW_BIN=
AIRFLOW_PUBLIC_URL=
AIRFLOW_UI_USERNAME=
# Local secret only. The deployer deliberately never prints it.
AIRFLOW_UI_PASSWORD=
# Set to yes only for a user-authorized demo handoff.
AIRFLOW_PRINT_UI_PASSWORD=no
AIRFLOW_DAG_ID=habitat_web_carga_archivo_externo
DAG_FILE=dags/habitat_web.py
DAG_CHECKSUM=dags/habitat_web.py.sha256
AIRFLOW_RUNTIME_ACTION=verify
MOCK_OWNERSHIP=external-reuse
MOCK_BASE_URL=http://127.0.0.1:8002
