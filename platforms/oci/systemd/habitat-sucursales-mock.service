[Unit]
Description=Habitat Sucursales mock backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/opt/habitat-sucursales/current/implementation
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MOCK_HOST=0.0.0.0
Environment=MOCK_PORT=8080
Environment=MOCK_PYTHON_BIN=/usr/bin/python3.11
Environment=MOCK_OUTPUT_DIR=/var/lib/habitat-sucursales/output
ExecStart=/opt/habitat-sucursales/current/implementation/start-mock-backend.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
